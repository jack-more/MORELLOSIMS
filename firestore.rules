rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The owner's account (admin in EMAIL_WHITELIST, morello-auth.js) reads
    // every account and the free list for /admin/. Firebase Auth keeps one
    // account per email, so the address can't be claimed by anyone else.
    function isOwner() {
      return request.auth != null && request.auth.token.get('email', '').lower() == 'jaidanmorello@gmail.com';
    }

    // Users can read their own document; the owner reads all of them
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isOwner();
      // Only Cloud Functions can write (admin SDK bypasses rules)
      allow write: if false;
    }

    // Tonight's picks for members — written only by the pick pipeline
    // (scripts/member_delivery.py, admin SDK). Readable by a signed-in account
    // with an active pass (the same rule as hasActiveAccess in functions/index.js)
    // or on the whitelist: EMAIL_WHITELIST in morello-auth.js, the fnf_whitelist
    // collection, or tier fnf. member_delivery.active_emails emails the same set.
    // The members pages ask this rule (a one-doc read) instead of re-checking.
    function hasActivePass() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('tier', 'free') in ['admin', 'fnf']
        || (u.get('accessExpiresAt', null) is timestamp && u.accessExpiresAt > request.time)
        || (u.get('checkoutMode', '') == 'subscription' && u.get('tier', 'free') != 'free');
    }
    function whitelisted() {
      let email = request.auth.token.get('email', '').lower();
      return email in ['jaidanmorello@gmail.com', 'webb.little19@gmail.com',
                       'samlittle2@gmail.com', 'kynanbarer@gmail.com']
        || (email != '' && exists(/databases/$(database)/documents/fnf_whitelist/$(email)));
    }
    match /member_picks/{pickId} {
      allow read: if request.auth != null
        && (whitelisted()
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && hasActivePass()));
      allow write: if false;
    }

    // Full dashboard cards of tonight's picked games (publish_member_cards.py), same readers as member_picks
    match /member_cards/{cardId} {
      allow read: if request.auth != null
        && (whitelisted()
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && hasActivePass()));
      allow write: if false;
    }

    // FnF whitelist — read-only, managed via Firebase console
    match /fnf_whitelist/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Email leads — written only by the emailCapture Cloud Function
    // (admin SDK bypasses rules). Only the owner reads them (/admin/).
    match /email_leads/{leadId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Tail/fade votes — written only by the recordTail Cloud Function.
    // Owner may read their own votes to render button state.
    match /user_tails/{userId}/picks/{pickId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Aggregate tail/fade counts — publicly readable, function-only writes
    match /tail_counts/{pickId} {
      allow read: if true;
      allow write: if false;
    }

    // Check-in streaks — written only by the checkIn Cloud Function.
    // Owner may read their own streak.
    match /user_streaks/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
