rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Only Cloud Functions can write (admin SDK bypasses rules)
      allow write: if false;
    }

    // Tonight's picks for paying members — written only by the pick pipeline
    // (scripts/member_delivery.py, admin SDK). Readable by a signed-in account
    // with an active pass: the same rule as hasActiveAccess in functions/index.js.
    function hasActivePass() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('tier', 'free') == 'admin'
        || (u.get('accessExpiresAt', null) is timestamp && u.accessExpiresAt > request.time)
        || (u.get('checkoutMode', '') == 'subscription' && u.get('tier', 'free') != 'free');
    }
    match /member_picks/{pickId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && hasActivePass();
      allow write: if false;
    }

    // FnF whitelist — read-only, managed via Firebase console
    match /fnf_whitelist/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Email leads — written only by the emailCapture Cloud Function
    // (admin SDK bypasses rules). No public access.
    match /email_leads/{leadId} {
      allow read, write: if false;
    }

    // Tail/fade votes — written only by the recordTail Cloud Function.
    // Owner may read their own votes to render button state.
    match /user_tails/{userId}/picks/{pickId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Aggregate tail/fade counts — publicly readable, function-only writes
    match /tail_counts/{pickId} {
      allow read: if true;
      allow write: if false;
    }

    // Check-in streaks — written only by the checkIn Cloud Function.
    // Owner may read their own streak.
    match /user_streaks/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
