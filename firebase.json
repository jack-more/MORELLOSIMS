{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      ".firebaserc",
      ".git/**",
      ".env",
      "**/.env",
      ".DS_Store",
      "**/.DS_Store",
      "**/__pycache__/**",
      ".claude/**",
      "functions/**",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(png|jpg|ico|svg)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/dog-club-lead",
        "function": "dogClubLead"
      },
      {
        "source": "/api/email-capture",
        "function": "emailCapture"
      },
      {
        "source": "/api/record-tail",
        "function": "recordTail"
      },
      {
        "source": "/api/check-in",
        "function": "checkIn"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
